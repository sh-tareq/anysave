{
  "manifest_version": 3,
  "name": "AnySave",
  "version": "1.2.0",
  "description": "Download videos from YouTube, Instagram, TikTok, Facebook and 1,000+ sites, download any file, and convert videos.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "storage",
    "cookies",
    "scripting",
    "downloads",
    "contextMenus",
    "downloads.ui",
    "downloads.open",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AnySave",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://ads.tiktok.com/business/creativecenter/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
